//----------------------------------------//
//aca ya moldeo el juego del pacman
import exampleClaseSabado.*

program pacmanGame {

    var juegoActivo = true /* DECLARO QUE EL JUEGO ESTE ACTIVO PARA USARLO DESP
     PARA DETENERLO PARA CAMBIAR EL FONDO DE FIN DE JUEGO*/
	
	// límites del juego
	game.width(14)
	game.height(8)
	
	// fondo
	game.boardGround("pacmanBackground.jpg")

    game.title("Pacman!")
	

    // personaje principal
	game.addVisualCharacter(pacman) // se encarga de agregar la visual del personaje ppal/ antes creado como objeto
	
    // rivales
	/*game.addVisual(new Rival(numero = 1))
	game.addVisual(new Rival(numero = 2))*/

    // rivales
    const rivales = [new Rival(numero = 1), new Rival(numero = 2)]	
	rivales.forEach { rival => 
		game.addVisual(rival)
		game.onCollideDo(rival, { personaje =>
			personaje.perderVida()
            if(personaje.juegoTerminado()) {
                game.say(personaje,"LPM, CAGUÉ FUEGO!, FIN DEL JUEGO")

               game.boardGround("TeCagasteMuriendo.jpg") // cambio la imagen de fondo // NO SE PUEDE

                juegoActivo = false // APAGO EL JUEGO PARA DETENER EL ONTRICK

                // Limpio las frutitas y los rivales para que no queden molestando arriba del fondo nuevo
                rivales.forEach { r => game.removeVisual(r) }
                cherrys.forEach { c => game.removeVisual(c) }

                game.removeVisual(personaje)
                
                //IA, ivestigar bien eñ SCHEDULE
                //  Usamos game.schedule para esperar unos segundos antes de frenar, 
                // dándole tiempo a la pantalla a mostrar el fondo nuevo y el mensaje.
                game.schedule(3000, {
                    game.stop()
                    })
            }
		})
		game.onTick(1.randomUpTo(5) * 1000, "movimiento", {
            if (juegoActivo) {
                rival.acercarseA(pacman)
            }
		})
	}
	

    //frutita
    const cherrys = generadorDeFrutas.crear(10)
	
	cherrys.forEach { cherry =>  
		game.addVisual(cherry)
		game.onCollideDo(cherry, { personaje =>
			personaje.aumentarVida()
            cherry.serComida()
   		})
	}

	// que arranque el juego!
	game.start()
	
}

